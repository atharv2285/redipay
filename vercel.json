{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/menu-items",
      "destination": "/api/menu-items"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
